# ========================================
# Finance App - Configurações de Ambiente
# ========================================

# Ambiente (development, production)
ENVIRONMENT=development

# ========================================
# Database Configuration
# ========================================
# Para desenvolvimento local com SQLite:
DATABASE_URL=sqlite:///./finance.db

# Para produção com PostgreSQL (Railway fornece automaticamente):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ========================================
# CORS Configuration
# ========================================
# Frontend URL para CORS
FRONTEND_URL=http://localhost:3000

# Múltiplas origens permitidas (separadas por vírgula)
# ALLOWED_ORIGINS=https://seu-frontend.vercel.app,https://outro-dominio.com

# ========================================
# Security
# ========================================
# Secret Key para JWT (gere uma chave segura em produção)
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao

# ========================================
# Railway Variables (fornecidas automaticamente)
# ========================================
# PORT - Porta onde o app vai rodar (Railway define automaticamente)
# DATABASE_URL - URL do PostgreSQL (Railway define se você adicionar o plugin)

# IA de classificação dos lançamentos (Groq). Modelo recomendado: qwen/qwen3.8-27b
GROQ_API_KEY=sua-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# Segurança
# Cadastro público de novos usuários (padrão: desligado)
REGISTRATION_ENABLED=false
# Para mostrar o link "Cadastre-se" na tela de login (build do frontend)
# VITE_REGISTRATION_ENABLED=true
# Limite de falhas de login numa janela (segundos)
# LOGIN_WINDOW_SECONDS=900
# LOGIN_MAX_FAILURES_PER_USER=8
# LOGIN_MAX_FAILURES_PER_IP=30
